<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>gov.llnl.wintap.api</RootNamespace>
    <ShipsInAlpha>true</ShipsInAlpha>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>WintapAPI</AssemblyTitle>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!-- 2026-10-22: Microsoft.CSharp and System.Data.DataSetExtensions removed — both in-box; ReferenceTrimmer and snitch agreed -->
  <ItemGroup>
    <Compile Remove="obj/**;bin/**" />
    <None Remove="obj/**;bin/**" />
    <Content Remove="obj/**;bin/**" />
    <EmbeddedResource Remove="obj/**;bin/**" />
  </ItemGroup>
</Project>
