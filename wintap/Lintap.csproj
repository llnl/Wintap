<Project Sdk="Microsoft.NET.Sdk.Web">
	<!-- Import common configuration -->
	<Import Project="Wintap.Common.props" />

	<!-- Linux-specific properties (merged and cleaned up) -->
	<PropertyGroup>
		<AssemblyName>Lintap</AssemblyName>
		<RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
        <DefineConstants Condition="'$(WintapCore)' == 'true'">$(DefineConstants);WINTAP_CORE</DefineConstants>
        <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
        <NuGetLockFilePath>$(MSBuildProjectDirectory)\locks\Lintap\packages.lock.json</NuGetLockFilePath>
		<UseSharedCompilation>false</UseSharedCompilation>
		<UseCommonOutputDirectory>false</UseCommonOutputDirectory>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>

		<!-- Prevent duplicate assembly attributes -->
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>

	<!-- Exclude platform code from other platforms (merged and de-duplicated) -->
	<ItemGroup>
		<!-- Exclude Windows platform -->
		<Compile Remove="..\platform\windows\**\*.cs" />
		<Compile Remove="platform\windows\**\*.cs" />

		<!-- Exclude macOS platform -->
		<Compile Remove="..\platform\macos\**\*.cs" />
		<Compile Remove="platform\macos\**\*.cs" />

		<!-- Exclude Windows-specific resolvers and managers -->
		<Compile Remove="..\**\WindowsProcessResolver.cs" />
		<Compile Remove="..\**\MacProcessResolver.cs" />
		<Compile Remove="..\**\WindowsSubscriptionManager.cs" />
		<Compile Remove="..\**\WindowsStateManager.cs" />

		<!-- Mark as content so they don't cause errors -->
		<None Include="platform\windows\**\*.cs" />
		<None Include="platform\macos\**\*.cs" />
	</ItemGroup>

    <!-- Match the core host selected by the shared package configuration. -->
    <ItemGroup Condition="'$(WintapCore)' == 'true'">
        <Compile Remove="core\api\**\*.cs" />
        <Compile Include="core\api\helpers\EnumFormatter.cs" />
        <Compile Remove="core\infrastructure\WintapInference.cs" />
        <Compile Remove="core\infrastructure\PluginMcpManager.cs" />
    </ItemGroup>
	<!-- Linux-specific packages -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
        <PackageReference Include="System.Management" />
        <PackageReference Include="System.Diagnostics.PerformanceCounter" />
	</ItemGroup>

	<!-- Linux-specific packages -->
	<ItemGroup>
		<None Include="platform/linux/sensor/ebpf/tracers/*.bpf.o" 
			CopyToOutputDirectory="PreserveNewest"
			Link="tracers/%(Filename)%(Extension)" />
		<Content Include="core/shared/systemprompt.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>systemprompt.txt</Link>
		</Content>
	</ItemGroup>

	<!-- Build and copy MCP server for Linux -->
	<PropertyGroup>
		<McpServerProject>$(MSBuildProjectDirectory)\..\shared\ai\wintap_mcp_server\wintap_mcp_server.csproj</McpServerProject>
		<EnableMcpServer Condition="'$(EnableMcpServer)' == '' and '$(DISABLE_MCP)' == 'true'">false</EnableMcpServer>
		<EnableMcpServer Condition="'$(EnableMcpServer)' == '' and '$(WintapCore)' != 'true'">true</EnableMcpServer>
		<McpTempDir>$(OutputPath)mcp_temp\</McpTempDir>
		<McpOutputDir>$(OutputPath)mcp\</McpOutputDir>
		<!-- 
		  McpPublishTempDir: where we publish the MCP server before copying into the project's output.
		  Use MCP_PUBLISH_TMP environment variable to override. If DISABLE_APPHOST is true (set by the
		  Makefile when building on host-shared filesystems), default to a VM-local temp directory to
		  avoid filesystem mmap/apphost issues.
		-->
		<McpPublishTempDir Condition="'$(MCP_PUBLISH_TMP)' != ''">$(MCP_PUBLISH_TMP)</McpPublishTempDir>
		<McpPublishTempDir Condition="'$(McpPublishTempDir)' == '' and '$(DISABLE_APPHOST)' == 'true'">/tmp/$(MSBuildProjectName)-mcp_temp/</McpPublishTempDir>
		<McpPublishTempDir Condition="'$(McpPublishTempDir)' == ''">$(McpTempDir)</McpPublishTempDir>
		<McpPublishTempDir>$([MSBuild]::EnsureTrailingSlash('$(McpPublishTempDir)'))</McpPublishTempDir>
		<McpObjDir>$(McpPublishTempDir)obj/</McpObjDir>
		<McpBinDir>$(McpPublishTempDir)bin/</McpBinDir>
	</PropertyGroup>

	<Target Name="BuildMcpServer" BeforeTargets="Build;Publish" Condition="'$(EnableMcpServer)' == 'true' and Exists('$(McpServerProject)')">
		<Message Text="Building MCP server for Linux..." Importance="high" />
		<MakeDir Directories="$(McpPublishTempDir)" />
		
		<!-- We create a variable that includes '-r ID' only if ID is present -->
		<PropertyGroup>
			<McpRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</McpRuntimeIdentifier>
			<McpRuntimeIdentifier Condition="'$(McpRuntimeIdentifier)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'Arm64'">linux-arm64</McpRuntimeIdentifier>
			<McpRuntimeIdentifier Condition="'$(McpRuntimeIdentifier)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'X64'">linux-x64</McpRuntimeIdentifier>
			<McpRuntimeIdentifier Condition="'$(McpRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</McpRuntimeIdentifier>
			<RuntimeArg Condition="'$(McpRuntimeIdentifier)' != ''"> -r $(McpRuntimeIdentifier)</RuntimeArg>
			<RuntimeArg Condition="'$(McpRuntimeIdentifier)' == ''"></RuntimeArg>
		</PropertyGroup>

		<Exec Command="dotnet publish &quot;$(McpServerProject)&quot; -c $(Configuration)$(RuntimeArg) --self-contained true -p:PublishSingleFile=true -p:UseAppHost=true -p:BaseIntermediateOutputPath=&quot;$(McpObjDir)&quot; -p:BaseOutputPath=&quot;$(McpBinDir)&quot; -o &quot;$(McpPublishTempDir)&quot;" 
			ContinueOnError="false" 
			IgnoreExitCode="false" />
	</Target>

	<Target Name="CopyMcpServer" AfterTargets="BuildMcpServer" Condition="Exists('$(McpPublishTempDir)wintap_mcp_server')">
		<MakeDir Directories="$(McpOutputDir)" />
		<Copy SourceFiles="$(McpPublishTempDir)wintap_mcp_server" DestinationFiles="$(McpOutputDir)wintap_mcp_server" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(McpPublishTempDir)wintap_mcp_server.dll" DestinationFiles="$(McpOutputDir)wintap_mcp_server.dll" SkipUnchangedFiles="true" Condition="Exists('$(McpPublishTempDir)wintap_mcp_server.dll')" />
		<Copy SourceFiles="$(McpPublishTempDir)wintap_mcp_server.deps.json" DestinationFiles="$(McpOutputDir)wintap_mcp_server.deps.json" SkipUnchangedFiles="true" Condition="Exists('$(McpPublishTempDir)wintap_mcp_server.deps.json')" />
		<Copy SourceFiles="$(McpPublishTempDir)wintap_mcp_server.runtimeconfig.json" DestinationFiles="$(McpOutputDir)wintap_mcp_server.runtimeconfig.json" SkipUnchangedFiles="true" Condition="Exists('$(McpPublishTempDir)wintap_mcp_server.runtimeconfig.json')" />
		<ItemGroup>
			<McpSupportFiles Include="$(McpPublishTempDir)*.so" />
		</ItemGroup>
		<Copy SourceFiles="@(McpSupportFiles)" DestinationFolder="$(McpOutputDir)" SkipUnchangedFiles="true" Condition="'@(McpSupportFiles)' != ''" />
		<RemoveDir Directories="$(McpPublishTempDir)" />
		<Message Text="Built and copied wintap_mcp_server to mcp" Importance="high" />
	</Target>

	<Target Name="CopyMcpServerToPublish" AfterTargets="Publish" Condition="Exists('$(McpOutputDir)wintap_mcp_server')">
		<MakeDir Directories="$(PublishDir)mcp" />
		<ItemGroup>
			<McpPublishFiles Include="$(McpOutputDir)**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(McpPublishFiles)" DestinationFiles="@(McpPublishFiles->'$(PublishDir)mcp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

	<!-- Set executable permissions on Linux binaries -->
	<Target Name="SetExecutablePermissions" AfterTargets="Publish" Condition="'$(OS)' == 'Unix'">
		<Exec Command="chmod +x $(PublishDir)Lintap" ContinueOnError="true" />
		<Exec Command="chmod +x $(PublishDir)mcp/wintap_mcp_server" ContinueOnError="true" Condition="Exists('$(PublishDir)mcp/wintap_mcp_server')" />
		<Message Text="✓ Set executable permissions on Lintap binaries" Importance="high" />
	</Target>
</Project>
