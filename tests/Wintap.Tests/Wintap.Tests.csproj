<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\WintapAPI\WintapAPI.csproj" />
    <!-- Linux platform sources are excluded from Wintap.csproj; compile the
         dependency-free helpers directly so their unit tests can run. -->
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\FileOpsAggregator.cs" Link="FileOpsAggregator.cs" />
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\DirIdentityIndex.cs" Link="DirIdentityIndex.cs" />
    <Compile Include="..\..\wintap\platform\linux\sensor\shared\KernelTimestampConverter.cs" Link="KernelTimestampConverter.cs" />
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\FileOpsDenyPolicy.cs" Link="FileOpsDenyPolicy.cs" />
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\SELinuxPermissionDecoder.cs" Link="SELinuxPermissionDecoder.cs" />
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\SELinuxSidResolver.cs" Link="SELinuxSidResolver.cs" />
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\helpers\ProcReader.cs" Link="ProcReader.cs" />
    <ProjectReference Include="..\..\wintap\Wintap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\wintap\wintapstate.json" Link="wintapstate.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\wintap\platform\linux\sensor\ebpf\tracers\file_ops_tracer.bpf.c" Link="file_ops_tracer.bpf.c">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\wintap\platform\linux\sensor\ebpf\tracers\file_ops_tracepoint.bpf.c" Link="file_ops_tracepoint.bpf.c">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\wintap\platform\linux\sensor\shared\BaseEbpfSensor.cs" Link="BaseEbpfSensor.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\wintap\platform\linux\sensor\ebpf\FileOpsSensor.cs" Link="FileOpsSensor.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\wintap\platform\linux\sensor\ebpf\NetworkSensor.cs" Link="NetworkSensor.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
