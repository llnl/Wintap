<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Wintap 7 sensor.
    WintapCore (default TRUE for the 7.0 alpha, Dave 2026-10-22): build only core telemetry collection.
      - no ASP.NET Core / Workbench API / SignalR
      - no in-process LLM client or MCP plugin loader
      - no wintap_mcp_server build+copy, no Angular Workbench copy
    Nothing is deleted from the repo: set /p:WintapCore=false (or flip the default) to build the full product.
  -->
  <Import Project="Wintap.Common.props" />

  <PropertyGroup>
    <WintapCore Condition="'$(WintapCore)' == ''">true</WintapCore>
    <ShipsInAlpha>true</ShipsInAlpha>
    <AssemblyName>Wintap</AssemblyName>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformVersion>10.0.17763.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(WintapCore)' == 'true'">$(DefineConstants);WINTAP_CORE</DefineConstants>
    <UseCommonOutputDirectory>false</UseCommonOutputDirectory>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Publish shape for the MSI: self-contained, single directory, ReadyToRun. Trimming OFF:
         NEsper compiles EPL with Roslyn at runtime and MEF loads plugins by reflection. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Full product only: ASP.NET Core shared framework (replaces the former Sdk.Web) -->
  <ItemGroup Condition="'$(WintapCore)' != 'true'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Core build: Workbench API, LLM client and MCP loader are not compiled. Files stay in the repo. -->
  <ItemGroup Condition="'$(WintapCore)' == 'true'">
    <Compile Remove="core\api\**\*.cs" />
    <Compile Remove="core\infrastructure\WintapInference.cs" />
    <Compile Remove="core\infrastructure\PluginMcpManager.cs" />
    <!-- AGENT: add any further file the compiler reports as depending on ASP.NET Core, Microsoft.Extensions.AI or ModelContextProtocol -->
  </ItemGroup>

  <!-- Windows-only packages — versions from Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="TaskScheduler" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="core\models\" />
  </ItemGroup>

  <!-- Full product only: build and copy the MCP server -->
  <Target Name="BuildMcpServer" BeforeTargets="Build" Condition="'$(WintapCore)' != 'true' and Exists('..\..\shared\ai\wintap_mcp_server\wintap_mcp_server.csproj')">
    <Exec Command="dotnet publish ..\..\shared\ai\wintap_mcp_server\wintap_mcp_server.csproj -c $(Configuration) -r win-x64 --self-contained false -o $(OutputPath)mcp_temp" ContinueOnError="true" IgnoreExitCode="true" />
  </Target>
  <Target Name="CopyMcpServer" AfterTargets="BuildMcpServer" Condition="'$(WintapCore)' != 'true' and Exists('$(OutputPath)mcp_temp\wintap_mcp_server.exe')">
    <Copy SourceFiles="$(OutputPath)mcp_temp\wintap_mcp_server.exe;$(OutputPath)mcp_temp\wintap_mcp_server.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(OutputPath)mcp_temp" />
  </Target>
</Project>
