<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\WintapAPI\WintapAPI.csproj" />
    <!-- Linux platform sources are excluded from Wintap.csproj; compile the
         dependency-free aggregator directly so its unit tests can run. -->
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\FileOpsAggregator.cs" Link="FileOpsAggregator.cs" />
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\DirIdentityIndex.cs" Link="DirIdentityIndex.cs" />
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\FileOpsDenyPolicy.cs" Link="FileOpsDenyPolicy.cs" />
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\SELinuxPermissionDecoder.cs" Link="SELinuxPermissionDecoder.cs" />
    <Compile Include="..\..\wintap\platform\linux\sensor\ebpf\SELinuxSidResolver.cs" Link="SELinuxSidResolver.cs" />
    <ProjectReference Include="..\..\wintap\Wintap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\wintap\wintapstate.json" Link="wintapstate.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
