<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Binary Id="WintapSplashBitmap" SourceFile="assets\WintapSplash.bmp" />
    <UI Id="WintapSplashUI">
      <Dialog Id="WintapSplashDlg" Width="370" Height="300" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="273" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="273" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="yes" Text="WintapSplashBitmap" />
        <Control Id="WelcomeText" Type="Text" X="12" Y="243" Width="346" Height="20" TabSkip="yes" Text="{\WixUI_Font_Title}Welcome to the Wintap installer" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>
      <!-- The last NewDialog event wins; redirect license Back for first installs. -->
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WintapSplashDlg" Order="2" Condition="NOT Installed" />
      <InstallUISequence>
        <!-- Use the artwork welcome for first installs; retain the standard patch welcome. -->
        <Show Dialog="WintapSplashDlg" After="CostFinalize" Condition="NOT Installed" />
        <Show Dialog="override WelcomeDlg" Before="ProgressDlg" Condition="Installed AND PATCH" />
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>
