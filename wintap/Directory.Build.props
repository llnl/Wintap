<Project>
  <Import Project="..\Directory.Build.props" />
  <!-- This file is automatically imported by all .csproj files in this directory -->
  
  <!-- Platform-specific intermediate output paths must be set before Microsoft.Common.props uses them. -->
  <PropertyGroup Condition="'$(NativeBuildRoot)' != ''">
    <NativeBuildRoot>$([MSBuild]::EnsureTrailingSlash('$(NativeBuildRoot)'))</NativeBuildRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Wintap' and '$(NativeBuildRoot)' == ''">
    <BaseIntermediateOutputPath>obj\Windows\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Lintap' and '$(NativeBuildRoot)' == ''">
    <BaseIntermediateOutputPath>obj\Linux\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Mactap' and '$(NativeBuildRoot)' == ''">
    <BaseIntermediateOutputPath>obj\macOS\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Wintap' and '$(NativeBuildRoot)' != ''">
    <BaseIntermediateOutputPath>$(NativeBuildRoot)Wintap/obj/Windows/</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Lintap' and '$(NativeBuildRoot)' != ''">
    <BaseIntermediateOutputPath>$(NativeBuildRoot)Lintap/obj/Linux/</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Mactap' and '$(NativeBuildRoot)' != ''">
    <BaseIntermediateOutputPath>$(NativeBuildRoot)Mactap/obj/macOS/</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Exclude Windows platform code from non-Windows builds -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Wintap'">
    <Compile Remove="platform\windows\**\*.cs" />
    <Compile Remove="Platform.Windows\**\*.cs" />
  </ItemGroup>

  <!-- Exclude Linux platform code from non-Linux builds -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Lintap'">
    <Compile Remove="platform\linux\**\*.cs" />
    <Compile Remove="Platform.Linux\**\*.cs" />
  </ItemGroup>

  <!-- Exclude macOS platform code from non-macOS builds -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Mactap'">
    <Compile Remove="platform\macos\**\*.cs" />
    <Compile Remove="platform\macOS\**\*.cs" />
    <Compile Remove="Platform.macOS\**\*.cs" />
  </ItemGroup>

  <!-- Exclude all test directories from all builds -->
  <ItemGroup>
    <Compile Remove="**\test\**\*.cs" />
  </ItemGroup>
</Project>
