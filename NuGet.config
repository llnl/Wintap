<?xml version="1.0" encoding="utf-8"?>
<!--
  Wintap NuGet policy (repo root). One feed, source-mapped, signatures required.
  Machine-level NuGet.Config sources are cleared so a developer box or proxy feed cannot
  satisfy a restore by accident (dependency-confusion defence).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <!-- 'require' fails restore for any package that is not signed by a trusted signer below -->
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <!-- Repository signature: proves nuget.org served the package. Covers every package in the set. -->
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <!-- owners restricts which nuget.org accounts may publish packages we accept -->
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <owners>aloneguid;aspnet;awsdotnet;dahall;dotnetfoundation;dotnetframework;Espertech;Giorgi;jamesnk;Microsoft;ModelContextProtocolOfficial;newtonsoft;vstest;xunit;asf;brycemecum;curt_hagenlocher;kou;kszucs;raulcd;Krashan;btburnett3;oleg-st;ericvergnaud;parrt;castleproject;jonorossi;mpollack;sbohlen;force;XLR8</owners>
    </repository>
    <!-- Author signatures: stronger, checked when present -->
    <author name="Microsoft">
      <certificate fingerprint="566A31882BE208BE4422F7CFD66ED09F5D4524A5994F50CCC8B05EC0528C1353" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="AA12DA22A49BCE7D5C1AE64CC1F3D892F150DA76140F210ABD2CBFFCA2C18A27" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="3F9001EA83C560D712C24CF213C3D312CB3BFF51EE89435D3430BD06B5D0EECE" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </author>
  </trustedSigners>
</configuration>
<!--
  AGENT: the fingerprint placeholders above are intentional - do not invent certificate
  fingerprints. Obtain them with
    dotnet nuget verify <any Microsoft .nupkg> -\-all
  and paste the SHA-256 fingerprints printed under "Repository signature" and "Author signature". The <owners> list must contain the
  nuget.org account that owns each package in Directory.Packages.props; `dotnet nuget verify`
  prints "Repository owners:" per package - reconcile the list from that output, do not guess.
  If restore fails with NU3034 the owner list is incomplete; add the printed owner, never relax the mode.
-->