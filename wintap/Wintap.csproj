<Project Sdk="Microsoft.NET.Sdk.Web">
	<!-- Import common configuration -->
	<Import Project="Wintap.Common.props" />

	<!-- Windows-specific properties -->
	<!-- Windows-specific properties -->
	<PropertyGroup>
		<AssemblyName>Wintap</AssemblyName>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
		<UseCommonOutputDirectory>false</UseCommonOutputDirectory>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<!-- Prevent duplicate assembly info generation -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<!-- DO NOT exclude Platform.Windows - we need it! -->
	<!-- Only Lintap and Mactap should exclude directories -->

	<!-- Windows-specific packages -->
	<ItemGroup>
		<Reference Include="Interop.SensEvents">
			<HintPath>lib\Interop.SensEvents.dll</HintPath>
			<EmbedInteropTypes>false</EmbedInteropTypes>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.23" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
		<PackageReference Include="Microsoft.Windows.Compatibility" Version="8.0.4" />
		<PackageReference Include="TaskScheduler" Version="2.11.1" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="core\models\" />
	  <Folder Include="platform\macos\sensor\" />
	</ItemGroup>

	<!-- Build and copy MCP server for Windows -->
	<Target Name="BuildMcpServer" BeforeTargets="Build" Condition="Exists('..\..\shared\ai\wintap_mcp_server\wintap_mcp_server.csproj')">
		<Message Text="Building MCP server for Windows..." Importance="high" />
		<Exec Command="dotnet publish ..\..\shared\ai\wintap_mcp_server\wintap_mcp_server.csproj -c $(Configuration) -r win-x64 --self-contained false -o $(OutputPath)mcp_temp" ContinueOnError="true" IgnoreExitCode="true" />
	</Target>

	<Target Name="CopyMcpServer" AfterTargets="BuildMcpServer" Condition="Exists('$(OutputPath)mcp_temp\wintap_mcp_server.exe')">
		<Copy SourceFiles="$(OutputPath)mcp_temp\wintap_mcp_server.exe" DestinationFiles="$(OutputPath)wintap_mcp_server.exe" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(OutputPath)mcp_temp\wintap_mcp_server.dll" DestinationFiles="$(OutputPath)wintap_mcp_server.dll" SkipUnchangedFiles="true" />
		<RemoveDir Directories="$(OutputPath)mcp_temp" />
		<Message Text="✓ Built and copied wintap_mcp_server.exe" Importance="high" />
	</Target>

</Project>
